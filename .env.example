# Copy to .env at the repo root (never commit .env). See the env table in AGENTS.md.
# Get your own keys from the echelon-prod project (echelon-prod-706c0). Never share keys in chat.

# Gemini API key (Cloud console -> APIs & Services -> Credentials, Gemini-restricted key)
GOOGLE_API_KEY=

# Absolute path to a Firebase service-account JSON stored OUTSIDE this repo
# (Firebase console -> Project settings -> Service accounts -> Generate new private key)
FIREBASE_CREDENTIALS_PATH=

# Postgres password for docker compose (local) and Openship. Letters and numbers only.
POSTGRES_PASSWORD=

# Legacy Databricks persistence (being replaced by Postgres)
DATABRICKS_CONFIG_PROFILE=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=

# Optional. Leave commented unless needed.
# GEMINI_API_KEY is only read from the shell env, and setting it here breaks tests/test_config.py.
# GEMINI_API_KEY=
# APP_NAME=Echelon Backend
# DEBUG=false
# Read into Settings but unused by the code:
# GEMINI_GENERATIVE_MODEL=gemini-3.8-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_EMBEDDING_DIMENSION=768
# DATABRICKS_HOST=
# DATABRICKS_AI_SEARCH_ENDPOINT=
# DATABRICKS_AI_SEARCH_INDEX=
